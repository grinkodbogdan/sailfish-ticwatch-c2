#!/bin/sh
# Bring up the WCNSS (pronto) WLAN: start the core, which downloads the NV
# calibration from /persist, then start the prima driver -> wlan0.
for i in $(seq 1 30); do [ -e /dev/wcnss_wlan ] && break; sleep 1; done
echo > /dev/wcnss_wlan 2>/dev/null
for i in $(seq 1 20); do
    [ -d /sys/class/net/wlan0 ] && exit 0
    echo 1 > /sys/module/wlan/parameters/fwpath 2>/dev/null
    sleep 2
done
[ -d /sys/class/net/wlan0 ]
